{
  "name": "drupal/webdoc",
  "description": "A quick and basic setup for Web Documentation, using the Book and Display Builder modules, to add documentation pages to the documentation section.",
  "type": "drupal-module",
  "homepage": "https://www.drupal.org/project/webdoc",
  "license": "GPL-2.0-or-later",
  "minimum-stability": "dev",
  "authors": [
    {
      "name": "Webship",
      "homepage": "https://webship.co",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://www.drupal.org/project/issues/webdoc",
    "source": "http://cgit.drupalcode.org/webdoc"
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  },
  "require": {
    "drupal/core": "^11.4 || ^12",
    "drupal/book": "~3.0",
    "drupal/manage_display": "~3.0",
    "drupal/pathauto": "~1.0",
    "drupal/display_builder": "^1.0@beta"
  }
}
