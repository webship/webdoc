# Ignore node modules
node_modules
/*/node_modules

# Ignore local gitlab-ci-local runtime + sidecar config.
# The canonical pipeline lives in .gitlab-ci.yml; the local CI is per-developer.
.gitlab-ci-local/
.gitlab-ci-local.yml
.cucumber.js.bak

# Ignore Claude Code project-scope MCP config (per-developer tooling).
.mcp.json

# Yarn 4 (Berry) state; the cache is rebuilt by CI.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
